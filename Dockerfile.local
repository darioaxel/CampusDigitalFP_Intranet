# =============================================================================
# Dockerfile para Campus Digital FP Intranet (BUILD LOCAL)
# =============================================================================
# USO: Primero hacer 'pnpm build' en local, luego 'docker build -f Dockerfile.local .'
# 
# Este Dockerfile usa pnpm fetch para instalar exactamente las mismas 
# dependencias del lockfile sin copiar node_modules desde local
# =============================================================================

FROM node:22-alpine AS production

# Instalar herramientas necesarias
RUN apk add --no-cache wget ca-certificates

WORKDIR /app

# Crear usuario no-root para ejecutar la aplicación
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nuxt -u 1001

# 1. Copiar SOLO lockfile primero (para cacheo máximo de capas)
COPY --chown=nuxt:nodejs pnpm-lock.yaml ./

# 2. Descargar todas las dependencias del lockfile (sin necesidad de package.json)
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate && \
    pnpm fetch

# 3. Copiar package.json y prisma (necesarios para install y postinstall)
COPY --chown=nuxt:nodejs package.json ./
COPY --chown=nuxt:nodejs prisma.config.ts ./
COPY --chown=nuxt:nodejs prisma ./prisma

# 4. Instalar dependencias desde el store (offline, rápido)
RUN pnpm install --offline --frozen-lockfile

# 5. Copiar el build ya hecho
COPY --chown=nuxt:nodejs .output ./.output

# Variables de entorno por defecto
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
ENV NITRO_PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

# Exponer puerto
EXPOSE 3000

# Cambiar a usuario no-root
USER nuxt

# Comando de inicio
CMD ["node", ".output/server/index.mjs"]
