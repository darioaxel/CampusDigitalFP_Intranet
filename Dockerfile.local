# =============================================================================
# Dockerfile para Campus Digital FP Intranet (BUILD LOCAL)
# =============================================================================
# USO: Primero hacer 'pnpm build' en local, luego 'docker build -f Dockerfile.local .'
# 
# Este Dockerfile:
#   - Copia el build ya hecho (.output/)
#   - Instala SOLO dependencias de producción (node_modules)
#   - Copia archivos necesarios para Prisma
# =============================================================================

FROM node:22-alpine AS production

# Instalar herramientas necesarias
RUN apk add --no-cache wget ca-certificates

WORKDIR /app

# Crear usuario no-root para ejecutar la aplicación
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nuxt -u 1001

# Copiar archivos de configuración de dependencias PRIMERO (para cacheo)
COPY --chown=nuxt:nodejs package.json pnpm-lock.yaml ./

# Instalar SOLO dependencias de producción
# Esto instala node_modules necesario para ejecutar la app
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate && \
    pnpm install --frozen-lockfile --production

# Copiar el build ya hecho (debe existir .output/ en tu máquina local)
COPY --chown=nuxt:nodejs .output ./.output

# Copiar archivos de Prisma (necesarios para migraciones)
COPY --chown=nuxt:nodejs prisma ./prisma
COPY --chown=nuxt:nodejs prisma.config.ts ./prisma.config.ts

# Variables de entorno por defecto
ENV NODE_ENV=production
ENV NUXT_TELEMETRY_DISABLED=1
ENV NITRO_PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

# Exponer puerto
EXPOSE 3000

# Cambiar a usuario no-root
USER nuxt

# Comando de inicio
CMD ["node", ".output/server/index.mjs"]
