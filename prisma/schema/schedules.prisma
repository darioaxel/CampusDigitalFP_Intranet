// schedules.prisma

// Cursos académicos (ej: 2024-2025, 2025-2026)
model AcademicYear {
  id          String   @id @default(uuid())
  name        String   // "2025-2026"
  startDate   DateTime // 1 de septiembre
  endDate     DateTime // 31 de julio
  
  isActive    Boolean  @default(false) // Solo un curso activo a la vez
  isClosed    Boolean  @default(false) // Curso cerrado/archivado
  
  // Descripción opcional
  description String?
  
  // Relaciones
  schedules   Schedule[]
  calendars   Calendar[] // Calendarios asociados a este curso
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([name])
  @@index([isActive])
  @@index([startDate])
}

model Schedule {
  id          String        @id @default(uuid())
  name        String        // "Horario Curso 2024", "Exámenes Septiembre"
  description String?
  isActive    Boolean       @default(true)
  type        ScheduleType  @default(NORMAL)
  validFrom   DateTime?     // Vigencia opcional del horario completo
  validUntil  DateTime?
  color       String?       // Para UI (ej: "#FF5733")
  isTemplate  Boolean   @default(false)  // Solo templates creados por ADMIN/ROOT
  
  validationStatus String @default("BORRADOR") // BORRADOR, PENDIENTE, VALIDADO, RECHAZADO

  // Relación con User
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestId   String?       @unique
  request     Request?      @relation("ScheduleValidation", fields: [requestId], references: [id])

  // Bloques de tiempo
  blocks      ScheduleBlock[]
  
  // Roles que pueden ver esta plantilla (solo para isTemplate = true)
  allowedRoles ScheduleTemplateRole[]
  
  // Curso académico asociado
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  
  // Relación con espacio (un horario puede estar asignado a un espacio)
  espacio Espacio?
  
  // Historial: si este horario es una copia de otro (para trazabilidad)
  parentScheduleId String?
  parentSchedule   Schedule?  @relation("ScheduleHistory", fields: [parentScheduleId], references: [id])
  childSchedules   Schedule[] @relation("ScheduleHistory")
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, isActive])
  @@index([type])
  @@index([validFrom, validUntil])
  @@index([academicYearId])
}

// Roles permitidos para ver/usar una plantilla de horario
model ScheduleTemplateRole {
  id          String   @id @default(uuid())
  
  scheduleId  String
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  role        Role     // PROFESOR, EXPERTO, JEFE_DEPT, etc.
  
  createdAt   DateTime @default(now())
  
  @@unique([scheduleId, role])
  @@index([scheduleId])
  @@index([role])
}

model ScheduleBlock {
  id          String     @id @default(uuid())
  
  // Relación
  scheduleId  String
  schedule    Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  // Tiempo: uso String "HH:MM" (24h) para evitar problemas de zona horaria y fechas dummy
  // Alternativa: Int (minutos desde 00:00) si necesitas cálculos matemáticos frecuentes
  startTime   String     // "08:30"
  endTime     String     // "14:00"
  
  // Estructura semanal
  dayOfWeek   DayOfWeek
  room        String?    // Aula, despacho, ubicación
  subject     String?    // Asignatura/actividad
  
  // Validación: endTime > startTime (la harás en lógica de negocio)
  isBreak     Boolean    @default(false) // Es recreo/pausa
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([scheduleId, dayOfWeek])
  @@unique([scheduleId, dayOfWeek, startTime, endTime]) // Evita duplicados exactos
}